{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "geargrid-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Every page is prerendered to its own HTML file; unknown URLs get dist/404.html
    // with a real 404 status (a single-page fallback would answer 200 with the home page).
    "not_found_handling": "404-page"
  }
}
